{
  "crons": [
    {
      "path": "/keep-alive",
      "schedule": "0 10 * * *"
    }
  ],
  "routes": [
    {
      "src": "/api/.*",
      "headers": {
        "Cache-Control": "no-store, max-age=0"
      }
    },
    {
      "src": "/media/.*",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/_next/static/(?:[^/]+/pages|chunks|runtime|css|images|media)/.*",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/_next/image",
      "headers": {
        "Cache-Control": "public, max-age=3600"
      }
    }
  ]
}
